<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>CV - Becaye Doumbouya</title>
  <style>
    @page { size: A4; margin: 0; }
    * { box-sizing: border-box; }
    body { margin: 0; background: #e9edf2; color: #1f2933; font-family: Arial, sans-serif; }
    .page { width: 210mm; min-height: 297mm; margin: 0 auto; background: #fff; padding: 17mm 17mm 14mm; }
    header { display: flex; justify-content: space-between; gap: 20px; padding-bottom: 14px; border-bottom: 4px solid #1e6474; }
    .avatar { width: 30mm; height: 30mm; flex: 0 0 30mm; border: 3px solid #dce6e8; border-radius: 50%; object-fit: cover; }
    h1 { margin: 0; color: #164e5b; font-size: 32px; letter-spacing: .5px; }
    .title { margin: 5px 0 0; color: #d06b3c; font-size: 15px; font-weight: bold; }
    .contact { text-align: right; color: #425466; font-size: 10.5px; line-height: 1.65; }
    .contact a { color: inherit; text-decoration: none; }
    main { display: grid; grid-template-columns: 1.55fr 1fr; gap: 24px; padding-top: 15px; }
    section { margin-bottom: 15px; }
    h2 { margin: 0 0 8px; padding-bottom: 5px; border-bottom: 2px solid #dce6e8; color: #164e5b; font-size: 13px; text-transform: uppercase; letter-spacing: 1px; }
    h3 { margin: 0; color: #253b45; font-size: 12.5px; }
    p { margin: 5px 0 0; font-size: 10.5px; line-height: 1.48; }
    .muted { color: #667784; font-size: 10px; }
    .item { margin-bottom: 12px; }
    .item:last-child { margin-bottom: 0; }
    .education-description { font-size: 9.5px; line-height: 1.35; }
    .date { float: right; color: #d06b3c; font-size: 10px; font-weight: bold; }
    ul { margin: 6px 0 0; padding-left: 16px; }
    li { margin: 4px 0; font-size: 10.5px; line-height: 1.35; }
    .skills { display: flex; flex-wrap: wrap; gap: 5px; }
    .skill { padding: 5px 7px; border-radius: 3px; background: #edf5f5; color: #164e5b; font-size: 9.5px; font-weight: bold; }
    .profile { margin-bottom: 15px; font-size: 11px; line-height: 1.55; }
    .link { color: #1e6474; word-break: break-word; }
    @media print { body { background: #fff; } .page { margin: 0; } }
  </style>
</head>
